    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData(\"global\");\nconst triggerData = $('Telegram Trigger').first().json;\n\nlet chatId = \"\";\nlet isCallback = false;\nlet answer = \"\";\nlet messageId = \"\"; // متغير جديد لحفظ معرف رسالة الأزرار\n\nif (triggerData.callback_query) {\n    isCallback = true;\n    chatId = triggerData.callback_query.message.chat.id.toString();\n    answer = triggerData.callback_query.data;\n    messageId = triggerData.callback_query.message.message_id; // التقاط الرقم هنا\n} else if (triggerData.message) {\n    isCallback = false;\n    chatId = triggerData.message.chat.id.toString();\n} else {\n    return { json: { error: \"نوع رسالة غير مدعوم\" } };\n}\n\nif (!staticData[chatId] || !isCallback) {\n    staticData[chatId] = {\n        stage: 0,\n        task_status: \"\",\n        task_type: \"\",\n        lecture_number: \"\",\n        delay: \"\"\n    };\n} \nelse if (isCallback) {\n    let currentStage = staticData[chatId].stage;\n    \n    if (currentStage === 0) { staticData[chatId].task_status = answer; }\n    else if (currentStage === 1) { staticData[chatId].task_type = answer; }\n    else if (currentStage === 2) { staticData[chatId].lecture_number = answer; }\n    else if (currentStage === 3) { staticData[chatId].delay = answer; }\n    \n    if (currentStage < 4) { staticData[chatId].stage++; }\n}\n\n// أضفنا messageId ليكون متاحاً للعقدة التالية\nreturn {\n    json: {\n        chatId: chatId,\n        messageId: messageId, \n        isCallback: isCallback,\n        stage: staticData[chatId].stage,\n        task_status: staticData[chatId].task_status,\n        task_type: staticData[chatId].task_type,\n        lecture_number: staticData[chatId].lecture_number,\n        delay: staticData[chatId].delay\n    }\n};"
      },
